// Links the Rust spike client (cargo xtask flutter-spike copies librz_spike_ffi.a into macos/rust/).
// Framework list from `cargo rustc -p rz-spike-ffi -- --print native-static-libs`.
OTHER_LDFLAGS = $(inherited) -L$(PROJECT_DIR)/rust -lrz_spike_ffi -framework Security -framework CoreFoundation -framework VideoToolbox -framework ScreenCaptureKit -framework UniformTypeIdentifiers -framework AVFoundation -framework CoreMedia -framework CoreVideo -framework CoreAudio -framework CoreGraphics -framework Metal -framework Foundation -lobjc -liconv

// macOS 27 is Apple-silicon only; the Rust lib is built for aarch64-apple-darwin.
ARCHS = arm64
EXCLUDED_ARCHS = x86_64
